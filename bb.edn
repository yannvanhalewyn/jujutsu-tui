{:paths ["src"]
 :deps {io.github.timokramer/charm.clj {:git/tag "v0.2.125" :git/sha "2116edb"}}
 :tasks
 {start {:doc "Run jjtui in the current directory"
         :requires ([jjtui.main])
         :task (apply jjtui.main/-main *command-line-args*)}

  test {:doc "Run the tests"
        :extra-paths ["test" "dev"]
        :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                     metosin/malli {:mvn/version "0.20.1"}}
        :task (exec 'cognitect.test-runner.api/test)
        :exec-args {:dirs ["test"]}}

  demo-repo {:doc "Create a throwaway jj repo to try jjtui in (default /tmp/jjtui-demo)"
             :extra-paths ["dev"]
             :requires ([jjtui.demo :as demo])
             :task (println "Created" (demo/create! (or (first *command-line-args*) "/tmp/jjtui-demo")))}

  demo-conflict-repo {:doc "Create a throwaway jj repo with a conflicted rebase (default /tmp/jjtui-conflict-demo)"
                      :extra-paths ["dev"]
                      :requires ([jjtui.demo-conflict :as demo])
                      :task (println "Created" (demo/create! (or (first *command-line-args*) "/tmp/jjtui-conflict-demo")))}

  demo-megamerge-repo {:doc "Create a throwaway jj repo with a megamerge of a feature, docs and dev changes (default /tmp/jjtui-megamerge-demo)"
                       :extra-paths ["dev"]
                       :requires ([jjtui.demo-megamerge :as demo])
                       :task (println "Created" (demo/create! (or (first *command-line-args*) "/tmp/jjtui-megamerge-demo")))}}}
